    <item>
      <title>MyPaste 1.3.0</title>
      <pubDate>Wed, 04 Nov 2026 03:36:53 +0000</pubDate>
      <sparkle:version>1.3.0</sparkle:version>
      <sparkle:shortVersionString>1.3.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Carousel with arrows and dots to move along with one click. Smarter search: sorted by relevance, tolerant of typos, and highlights what it found (including text in images). Edit a text before pasting it and transform it (uppercase, link without tracking, JSON…). Pinboards with colors, manual order and ⌥1–9 shortcuts. Export and import the history. Updates now install by themselves while you're away from the Mac.</p>]]></description>
      <enclosure url="https://github.com/fernandorm/mac-app-updates/releases/download/mypaste-v1.3.0/MyPaste-1.3.0.zip" length="2473102" type="application/octet-stream" sparkle:edSignature="Fz4GsJ8V6SVJ7mic8JfCRtAj83tuJUN8WXOMLSHjH1znsfveuK/mRUfCWB8twpwd/oH5hJcCFMv+IbSxE4ziCQ=="/>
    </item>

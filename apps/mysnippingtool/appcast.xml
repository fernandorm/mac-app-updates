      <sparkle:version>1.0.0</sparkle:version>
      <sparkle:shortVersionString>1.0.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>First version: area, window, full-screen and scrolling captures; an editor with annotations; copy text (OCR); eyedropper; pinned captures.</p>]]></description>

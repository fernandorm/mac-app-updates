    <item>
      <title>MySnippingTool 1.4.0</title>
      <pubDate>Wed, 04 Nov 2026 05:40:53 +0000</pubDate>
      <sparkle:version>1.4.0</sparkle:version>
      <sparkle:shortVersionString>1.4.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>You can now open images in the editor from other apps: with “Open With” in the Finder or with “Edit in MySnippingTool” in MyPaste.</p>]]></description>
      <enclosure url="https://github.com/fernandorm/mac-app-updates/releases/download/mysnippingtool-v1.4.0/MySnippingTool-1.4.0.zip" length="2416717" type="application/octet-stream" sparkle:edSignature="WEkUw3DxjHWM3Ml4uKFIGPWUwSSBKiwWU+27suoMv3mGqx8Gf2EbfnMEG7q2ZLkMhci84VnzTg7MCa1tznunBA=="/>

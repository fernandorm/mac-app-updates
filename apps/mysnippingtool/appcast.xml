    <item>
      <title>MySnippingTool 1.3.0</title>
      <pubDate>Wed, 04 Nov 2026 05:36:03 +0000</pubDate>
      <sparkle:version>1.3.0</sparkle:version>
      <sparkle:shortVersionString>1.3.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Picking a color is easier: in the editor, ⌘-click the image to copy the color at that point and draw with it. ⌘⇧-click does the same with the text color.</p>]]></description>
      <enclosure url="https://github.com/fernandorm/mac-app-updates/releases/download/mysnippingtool-v1.3.0/MySnippingTool-1.3.0.zip" length="2416352" type="application/octet-stream" sparkle:edSignature="poQSIBqMEUGBpxngj9cP8UOrSPHUTa++HZeMVSupav2CMM4o6ZTQJuz22l1sK0/i6Q7eQgVUfarppgLtfW6dDw=="/>
    </item>
    <item>
      <title>MySnippingTool 1.2.1</title>
      <pubDate>Wed, 04 Nov 2026 04:45:34 +0000</pubDate>
      <sparkle:version>1.2.1</sparkle:version>
      <sparkle:shortVersionString>1.2.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>The editor now opens automatically after every capture. If you prefer the floating thumbnail, change it in Settings → General → After a capture.</p>]]></description>
      <enclosure url="https://github.com/fernandorm/mac-app-updates/releases/download/mysnippingtool-v1.2.1/MySnippingTool-1.2.1.zip" length="2415756" type="application/octet-stream" sparkle:edSignature="pV1WfGqAAngHeMr8Rpmp417fg264+ZbOqxvHY0vfKIHjsPLdkWVMVimETE8ZILQk05W2M3ypBrpWu+RAw3UIDw=="/>
    </item>
    <item>
      <title>MySnippingTool 1.2.0</title>
      <pubDate>Wed, 04 Nov 2026 04:42:55 +0000</pubDate>
      <sparkle:version>1.2.0</sparkle:version>
      <sparkle:shortVersionString>1.2.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Better color picking: the editor shows the color under the pointer live. ⇥ copies that pixel, ⇧⇥ copies the text color, and the new eyedropper tool (I) copies the average color of an area as you drag. The screen eyedropper works the same way. Clicking the color lets you choose the format (HEX, RGB or HSL).</p>]]></description>
      <enclosure url="https://github.com/fernandorm/mac-app-updates/releases/download/mysnippingtool-v1.2.0/MySnippingTool-1.2.0.zip" length="2415706" type="application/octet-stream" sparkle:edSignature="Jqvc/zf1tQ5S4EiXn4a9kz0FH8OsU+XkM3Xe1orUGroN+p2cb3y1a8TfYkUAEuHris3aZaisAc5QwXgw9pLEDA=="/>
    </item>
    <item>
      <title>MySnippingTool 1.1.0</title>
      <pubDate>Wed, 04 Nov 2026 04:38:36 +0000</pubDate>
      <sparkle:version>1.1.0</sparkle:version>
      <sparkle:shortVersionString>1.1.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Arrows can now bend: when you draw an arrow, handles appear to move its ends, plus a middle handle to curve it. With the selection tool, click any arrow to edit it again.</p>]]></description>
      <enclosure url="https://github.com/fernandorm/mac-app-updates/releases/download/mysnippingtool-v1.1.0/MySnippingTool-1.1.0.zip" length="2393011" type="application/octet-stream" sparkle:edSignature="lpZ8MuM2MdOsgymoKROVRv2YMmKOM22rMuxSj+SKhRF2M824G0LajmvGPG0xfDWs9BhAt3O9qCVZa7yuCiwIBg=="/>
    </item>

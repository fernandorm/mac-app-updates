    <item>
      <title>ClipMaker 1.5.0</title>
      <pubDate>Sun, 08 Nov 2026 17:55:06 +0000</pubDate>
      <sparkle:version>1.5.0</sparkle:version>
      <sparkle:shortVersionString>1.5.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>26.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>High-quality voice separation: an optional one-time install (Demucs, about 1 GB, runs on your Mac) separates voices from music much more cleanly — voices no longer leak into the Background track. A piece you already separated can be separated again to replace its tracks.</p>]]></description>
      <enclosure url="https://github.com/fernandorm/mac-app-updates/releases/download/clipmaker-v1.5.0/ClipMaker-1.5.0.zip" length="5981329" type="application/octet-stream" sparkle:edSignature="ywy/EMshcYtr1iX5SAeTsB6VTfNNNx0pKqqwL2KmCpEB6SRSLv6VGWwUpy2ggVxxSr5Q8AH8DWt+f9N7ZWpHAQ=="/>
    </item>
    <item>
      <title>ClipMaker 1.4.0</title>
      <pubDate>Sun, 08 Nov 2026 17:38:12 +0000</pubDate>
      <sparkle:version>1.4.0</sparkle:version>
      <sparkle:shortVersionString>1.4.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>26.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>New in the video editor: a Mute track button at the left of each track (video and every audio row) mutes or unmutes the whole track in one click — for example, mute Background after separating voice and background.</p>]]></description>
      <enclosure url="https://github.com/fernandorm/mac-app-updates/releases/download/clipmaker-v1.4.0/ClipMaker-1.4.0.zip" length="5945799" type="application/octet-stream" sparkle:edSignature="ib1TtHpDAujQLV06Cp6wejz4csoqFYsSEpsyt34jr6NNWdxVDwJTe7Yyga/coop8BvvjZxqAD+ubuYVxNhIdBQ=="/>
    </item>
    <item>
      <title>ClipMaker 1.3.0</title>
      <pubDate>Sun, 08 Nov 2026 17:16:25 +0000</pubDate>
      <sparkle:version>1.3.0</sparkle:version>
      <sparkle:shortVersionString>1.3.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>26.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>New in the video editor: Separate voice and background. Right-click a piece or an audio clip to split its sound into two tracks — the voice alone and the music/noise — so you can lower, remove or replace either one. Everything is processed on your Mac.</p>]]></description>
      <enclosure url="https://github.com/fernandorm/mac-app-updates/releases/download/clipmaker-v1.3.0/ClipMaker-1.3.0.zip" length="5933781" type="application/octet-stream" sparkle:edSignature="5F4QTTnhkC+w33g04VWn513fGZ7HqmgAV44lzB/7hygdl0QhkPMcHyZgae0tXD0oBCUeKePvwEiWsSAH0oXWCQ=="/>
    </item>
    <item>
      <title>ClipMaker 1.2.0</title>
      <pubDate>Sat, 07 Nov 2026 13:24:09 +0000</pubDate>
      <sparkle:version>1.2.0</sparkle:version>
      <sparkle:shortVersionString>1.2.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>26.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Right-click a video in an edit's Media panel (or in the links list) and choose Show in Finder to open the folder where it is saved. Links can also be copied from the right-click menu.</p>]]></description>
      <enclosure url="https://github.com/fernandorm/mac-app-updates/releases/download/clipmaker-v1.2.0/ClipMaker-1.2.0.zip" length="5888771" type="application/octet-stream" sparkle:edSignature="Qf6LwHITtYSApx8npCQe8EM0v/2toXBXEQ/td5DnYJiQRgHmhJCHMNC8wgULtOJjLPoYsCbSFxZnV6rmBUcEDQ=="/>
